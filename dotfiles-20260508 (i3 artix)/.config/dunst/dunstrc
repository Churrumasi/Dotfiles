[global]
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 300)
    origin = bottom-right
    offset = (10, 40)
    frame_color = "#BF616A"
    separator_color = "#A3BE8C"
    padding = 10
    text_icon_padding = 8
    max_icon_size = 64
    font = Monospace 10

[urgency_low]
    background = "#3B4252"
    foreground = "#ECEFF4"
    frame_color = "#88C0D0"
    timeout = 4

[urgency_normal]
    background = "#BF616A"
    foreground = "#ECEFF4"
    frame_color = "#81A1C1"
    timeout = 8

[urgency_critical]
    background = "#A3BE8C"
    foreground = "#3B4252"
    frame_color = "#FF0000"
    timeout = 0
