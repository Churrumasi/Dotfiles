[global]
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 300)
    origin = bottom-right
    offset = (10, 40)
    frame_color = "#B13836"
    separator_color = "#D8CB45"
    padding = 10
    text_icon_padding = 8
    max_icon_size = 64
    font = Monospace 10

[urgency_low]
    background = "#0a030e"
    foreground = "#dbd1da"
    frame_color = "#7C89E1"
    timeout = 4

[urgency_normal]
    background = "#B13836"
    foreground = "#dbd1da"
    frame_color = "#9759AF"
    timeout = 8

[urgency_critical]
    background = "#D8CB45"
    foreground = "#0a030e"
    frame_color = "#FF0000"
    timeout = 0
