[global]
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 300)
    origin = bottom-right
    offset = (10, 40)
    frame_color = "#A85DAF"
    separator_color = "#E55F9C"
    padding = 10
    text_icon_padding = 8
    max_icon_size = 64
    font = Monospace 10

[urgency_low]
    background = "#2e2328"
    foreground = "#ddcfd8"
    frame_color = "#D397AB"
    timeout = 4

[urgency_normal]
    background = "#A85DAF"
    foreground = "#ddcfd8"
    frame_color = "#49D1D3"
    timeout = 8

[urgency_critical]
    background = "#E55F9C"
    foreground = "#2e2328"
    frame_color = "#FF0000"
    timeout = 0
