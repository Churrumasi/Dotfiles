[global]
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 300)
    origin = bottom-right
    offset = (10, 40)
    frame_color = "#0d5771"
    separator_color = "#116a84"
    padding = 10
    text_icon_padding = 8
    max_icon_size = 64
    font = Monospace 10

[urgency_low]
    background = "#12212a"
    foreground = "#c3c7c9"
    frame_color = "#167e9c"
    timeout = 4

[urgency_normal]
    background = "#0d5771"
    foreground = "#c3c7c9"
    frame_color = "#398e84"
    timeout = 8

[urgency_critical]
    background = "#116a84"
    foreground = "#12212a"
    frame_color = "#FF0000"
    timeout = 0
