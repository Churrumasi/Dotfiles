[global]
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 300)
    origin = bottom-right
    offset = (10, 40)
    frame_color = "#5D75C4"
    separator_color = "#AD3385"
    padding = 10
    text_icon_padding = 8
    max_icon_size = 64
    font = Monospace 10

[urgency_low]
    background = "#131139"
    foreground = "#e4d3cb"
    frame_color = "#E6969A"
    timeout = 4

[urgency_normal]
    background = "#5D75C4"
    foreground = "#e4d3cb"
    frame_color = "#DC6F90"
    timeout = 8

[urgency_critical]
    background = "#AD3385"
    foreground = "#131139"
    frame_color = "#FF0000"
    timeout = 0
