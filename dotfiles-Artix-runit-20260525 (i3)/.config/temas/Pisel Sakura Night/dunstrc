[global]
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 300)
    origin = bottom-right
    offset = (10, 40)
    frame_color = "#9E629F"
    separator_color = "#E07197"
    padding = 10
    text_icon_padding = 8
    max_icon_size = 64
    font = Monospace 10

[urgency_low]
    background = "#0b0b1a"
    foreground = "#d6d7e0"
    frame_color = "#EE9EE0"
    timeout = 4

[urgency_normal]
    background = "#9E629F"
    foreground = "#d6d7e0"
    frame_color = "#539BB9"
    timeout = 8

[urgency_critical]
    background = "#E07197"
    foreground = "#0b0b1a"
    frame_color = "#FF0000"
    timeout = 0
