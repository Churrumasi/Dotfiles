[global]
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 300)
    origin = bottom-right
    offset = (10, 40)
    frame_color = "#90556E"
    separator_color = "#6C658F"
    padding = 10
    text_icon_padding = 8
    max_icon_size = 64
    font = Monospace 10

[urgency_low]
    background = "#180f23"
    foreground = "#c5c3c8"
    frame_color = "#8D908A"
    timeout = 4

[urgency_normal]
    background = "#90556E"
    foreground = "#c5c3c8"
    frame_color = "#946F98"
    timeout = 8

[urgency_critical]
    background = "#6C658F"
    foreground = "#180f23"
    frame_color = "#FF0000"
    timeout = 0
